--- This is what an import might look like.
--- #import $TOOLS/hdSt/shaders/meshFaceCull.glslfx


--- --------------------------------------------------------------------------
-- glsl MeshFaceCull.Fragment.None

void DiscardBasedOnShading(bool frontFacing, bool isFlipped)
{
    // Nothing to do since h/w face culling is used.
}

--- --------------------------------------------------------------------------
-- glsl MeshFaceCull.Fragment.FrontFacing

void DiscardBasedOnShading(bool frontFacing, bool isFlipped)
{
    if (frontFacing != isFlipped) {
        discard;
    }
}

--- --------------------------------------------------------------------------
-- glsl MeshFaceCull.Fragment.BackFacing

void DiscardBasedOnShading(bool frontFacing, bool isFlipped)
{
    if ((!frontFacing) != isFlipped) {
        discard;
    }
}

--- --------------------------------------------------------------------------
-- glsl MeshFaceCull.Fragment.WireframeLineFallback.SingleSided

void DiscardBasedOnShading(bool frontFacing, bool isFlipped)
{
    const uint HdCullStyleBack = 2;
    const uint HdCullStyleFront = 3;
    const uint HdCullStyleBackUnlessDoubleSided = 4;
    const uint HdCullStyleFrontUnlessDoubleSided = 5;

    uint cullStyle = 0;
#if defined(HD_HAS_cullStyle)
    cullStyle = HdGet_cullStyle();
#endif

    if (isFlipped) {
        frontFacing = !frontFacing;
    }
    if (((cullStyle == HdCullStyleBack ||
            cullStyle == HdCullStyleBackUnlessDoubleSided) && !frontFacing) ||
        ((cullStyle == HdCullStyleFront ||
            cullStyle == HdCullStyleFrontUnlessDoubleSided) && frontFacing)) {
        discard;
    }
}

--- --------------------------------------------------------------------------
-- glsl MeshFaceCull.Fragment.WireframeLineFallback.DoubleSided

void DiscardBasedOnShading(bool frontFacing, bool isFlipped)
{
    const uint HdCullStyleBack = 2;
    const uint HdCullStyleFront = 3;

    uint cullStyle = 0;
#if defined(HD_HAS_cullStyle)
    cullStyle = HdGet_cullStyle();
#endif

    if (isFlipped) {
        frontFacing = !frontFacing;
    }
    if ((cullStyle == HdCullStyleBack && !frontFacing) ||
        (cullStyle == HdCullStyleFront && frontFacing)) {
        discard;
    }
}
