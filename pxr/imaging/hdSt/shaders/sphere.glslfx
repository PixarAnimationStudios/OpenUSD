--- This is what an import might look like.
--- #import $TOOLS/hdSt/shaders/sphere.glslfx

--- --------------------------------------------------------------------------
-- glsl ImplicitSurface.TypeDef.Sphere

struct Sphere
{
    vec3 center;
    float radius;
};

--- --------------------------------------------------------------------------
-- glsl ImplicitSurface.Bounds.Sphere

// Computes the min and max bounds for the given sphere in eye space.
Bbox ComputeSphereBboxEye(const Sphere sphere, const MAT4 instanceModelView)
{
    const vec3 objectCenterEye = TransformPoint(instanceModelView, sphere.center);

    // Get max x, y, and z radii for the sphere's bounding box in eye space
    const vec3 bboxSizeEye = sphere.radius *
                             rowLengths(Mat4ToMat3(instanceModelView));

    Bbox bboxEye;
    bboxEye.minBound = objectCenterEye - bboxSizeEye;
    bboxEye.maxBound = objectCenterEye + bboxSizeEye;

    return bboxEye;
}

--- --------------------------------------------------------------------------
-- glsl ImplicitSurface.Vertex.Sphere

// Computes the min and max bounds for the sphere in eye space.
Bbox ComputeBboxEye()
{
    const MAT4 transform  = ApplyInstanceTransform(HdGet_transform());
    const MAT4 viewMat = GetWorldToViewMatrix();

    const MAT4 instanceModelView = viewMat * transform;
    
    Sphere sphere;
    sphere.center = vec3(0.0);
    sphere.radius = HdGet_radius();

    return ComputeSphereBboxEye(sphere, instanceModelView);
}

--- --------------------------------------------------------------------------
-- glsl ImplicitSurface.Intersection.Sphere

// Computes the near/far hit distances in object space for a ray intersecting
// the given sphere.
// The ray direction need not be normalized.
vec2 ComputeSphereHitDists(const Sphere sphere, const Ray rayObj)
{
    // Coeffs for the quadratic equation for the sphere
    const float a = dot(rayObj.dir, rayObj.dir);
    const float halfB = dot(rayObj.origin - sphere.center, rayObj.dir);
    const float c = dot(rayObj.origin, rayObj.origin) 
                    + dot(sphere.center, sphere.center - 2 * rayObj.origin)
                    - sphere.radius * sphere.radius;

    return ComputeRoots(a, halfB, c);
}

// Computes the (unnormalized) normal direction for the point on the
// given sphere in object space.
// It is assumed that Pobj is a point on the surface of the sphere.
vec3 ComputeSphereNormal(const Sphere sphere, const vec3 Pobj)
{
    return Pobj - sphere.center;
}

--- --------------------------------------------------------------------------
-- glsl ImplicitSurface.Fragment.Sphere

// Computes the near/far hit points in object space for a ray intersecting
// the sphere.
// The ray direction need not be normalized.
HitPoints ComputeHitPointsObj(Ray rayObj)
{
    Sphere sphere;
    sphere.center = vec3(0.0);
    sphere.radius = HdGet_radius();

    const vec2 dists = ComputeSphereHitDists(sphere, rayObj);

    HitPoints hits;

    hits.near.visible = dists.x >= 0.0;
    hits.far.visible = dists.y >= 0.0;

    // The sphere has a single analytic surface, so segment is unused.
    if (hits.near.visible) {
        hits.near.point.position = rayObj.origin + dists.x * rayObj.dir;
        hits.near.point.segment = 0;
    }

    if (hits.far.visible) {
        hits.far.point.position = rayObj.origin + dists.y * rayObj.dir;
        hits.far.point.segment = 0;
    }

    return hits;
}

// Computes the (unnormalized) object-space normal at the given point on the
// sphere.
vec3 ComputeNormalObj(const Point point)
{
    Sphere sphere;
    sphere.center = vec3(0.0);
    sphere.radius = HdGet_radius();

    return ComputeSphereNormal(sphere, point.position);
}
