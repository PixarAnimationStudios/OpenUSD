--- This is what an import might look like.
--- #import $TOOLS/hdSt/shaders/sphere.glslfx

#import $TOOLS/hdSt/shaders/coordUtils.glslfx
#import $TOOLS/hdSt/shaders/instancing.glslfx
#import $TOOLS/hdSt/shaders/sphereFaceCull.glslfx
#import $TOOLS/hdSt/shaders/sphereNormal.glslfx
#import $TOOLS/hdSt/shaders/terminals.glslfx
#import $TOOLS/hdSt/shaders/edgeId.glslfx
#import $TOOLS/hdSt/shaders/pointId.glslfx

--- --------------------------------------------------------------------------
-- layout Sphere.Vertex

[
    ["out block", "VertexData", "outData",
        ["vec3", "Peye"]
    ]
]

--- --------------------------------------------------------------------------
-- glsl Sphere.Vertex

vec3 columnLengths(mat3 m)
{
    return vec3(length(m[0]), length(m[1]), length(m[2]));
}

vec3 rowLengths(mat3 m)
{
    return columnLengths(transpose(m));
}

void main(void)
{
    ProcessPrimvarsIn();

    const MAT4 transform  = ApplyInstanceTransform(HdGet_transform());

    const MAT4 viewMat = GetWorldToViewMatrix();
    const MAT4 projMat = GetProjectionMatrix();
    const MAT4 viewModel = viewMat * transform;

    const vec3 sphereCenterEye = TransformPoint(viewModel, vec3(0.0));
    
    const float radius = HdGet_radius();

    // Get max x, y, and z radii for the sphere in eye space
    const vec3 bboxSizeEye = radius * rowLengths(Mat4ToMat3(viewModel));

    // Get bounds for the sphere in eye space
    const vec3 bboxMinEye = sphereCenterEye - bboxSizeEye;
    const vec3 bboxMaxEye = sphereCenterEye + bboxSizeEye;

    // Get min and max x and y values in screen space.
    // Converting to vec4 explicitly in case projMat is a double-precision matrix
    const vec4 clipMinBack = vec4(projMat * vec4(
                                  bboxMinEye, 1.0));

    const vec4 clipMaxBack = vec4(projMat * vec4(
                                  bboxMaxEye.xy,
                                  bboxMinEye.z, 1.0));

    const vec4 clipMinFront = vec4(projMat * vec4(
                                   bboxMinEye.xy,
                                   bboxMaxEye.z, 1.0));

    const vec4 clipMaxFront = vec4(projMat * vec4(
                                   bboxMaxEye, 1.0));

    vec3 xyzmin = min(clipMinFront.xyz / clipMinFront.w,
                      clipMinBack.xyz / clipMinBack.w);
    vec3 xyzmax = max(clipMaxFront.xyz / clipMaxFront.w,
                      clipMaxBack.xyz / clipMaxBack.w);

    const float nearPlaneNDC = GetNearPlaneNDC();

    // If the entire sphere is behind the camera, early out
    if (clipMinBack.w < 0.0) {
        gl_Position = vec4(0, 0, nearPlaneNDC - 1.0, 1);
        outData.Peye = vec3(0);
        return;
    }
    // If part of the sphere is behind the camera, clip x and y bounds to
    // -1.0, 0.0 or 1.0 depending on their eye space positions.
    // Also clip z lower bound to the near plane, since the perspective division
    // might yield a large positive value for it, in this case.
    if (clipMinFront.w < 0.0) {
        xyzmin.z = nearPlaneNDC;

        if (clipMinFront.x < 0.0) {
            xyzmin.x = -1.0;
        } else {
            xyzmin.x = 0.0;
        }

        if (clipMaxFront.x < 0.0) {
            xyzmax.x = 0.0;
        } else {
            xyzmax.x = 1.0;
        }

        if (clipMinFront.y < 0.0) {
            xyzmin.y = -1.0;
        } else {
            xyzmin.y = 0.0;
        }

        if (clipMaxFront.y < 0.0) {
            xyzmax.y = 0.0;
        } else {
            xyzmax.y = 1.0;
        }
    }

    const float zmin = min(xyzmax.z, max(nearPlaneNDC, xyzmin.z));

    // Early out if sphere is not visible
    if (zmin < nearPlaneNDC) {
        gl_Position = vec4(0, 0, zmin, 1);
        outData.Peye = vec3(0);
        return;
    }

    vec2 xyNDC;
    switch(hd_VertexID)
    {
        case 0:
            xyNDC = vec2(xyzmin.x, xyzmax.y);
            break;
        case 1:
            xyNDC = xyzmax.xy;
            break;
        case 2:
            xyNDC = vec2(xyzmax.x, xyzmin.y);
            break;
        default:
            xyNDC = xyzmin.xy;
            break;
    }

    gl_Position = vec4(xyNDC, zmin, 1.0);
    
    // When calculating Peye, push the billboard slightly away from the surface,
    // because the FS uses Peye as rayOrigin
    const float epsilon = 1e-5;
    outData.Peye = TransformPoint(GetProjectionInverseMatrix(), vec3(xyNDC, zmin - epsilon));
}

--- --------------------------------------------------------------------------
-- layout Sphere.Fragment

[
    ["in block", "VertexData", "inData",
        ["vec3", "Peye"]
    ]
]

--- --------------------------------------------------------------------------
-- glsl Sphere.Fragment

// Computes the 2 hit distances in object space for a ray intersecting the sphere.
// It is assumed that rayOrigin and rayDir are in object space.
// rayDir need not be normalized.
vec2 IntersectObjSpace(vec3 rayOrigin, vec3 rayDir)
{
    const float radius = HdGet_radius();

    // Coeffs for the quadratic equation for the sphere
    const float a = dot(rayDir, rayDir);
    const float halfB = dot(rayOrigin, rayDir);
    const float c = dot(rayOrigin, rayOrigin) - radius * radius;

    // Discriminant
    const float quarterH = halfB * halfB - a * c;

    if(quarterH < 0.0) {
        return vec2(-1.0);
    }
    
    const float sqrtQuarterH = sqrt(quarterH);

    const float t1 = -halfB - sqrtQuarterH;
    const float t2 = -halfB + sqrtQuarterH;

    return vec2(t1, t2)/a;
}

void main(void)
{
    const MAT4 instanceModelView = GetWorldToViewMatrix() * ApplyInstanceTransform(HdGet_transform());

    const MAT4 instanceModelViewInverse = ApplyInstanceTransformInverse(HdGet_transformInverse()) * 
                                            GetWorldToViewInverseMatrix();

    const vec3 rayDirEye = ComputeRayDirectionEye(inData.Peye);
    const vec3 rayDirObj = TransformDir(instanceModelViewInverse, rayDirEye);

    const vec3 rayOriginObj = TransformPoint(instanceModelViewInverse,
                                             inData.Peye);

    const vec2 hitDists = IntersectObjSpace(rayOriginObj, rayDirObj);

    const bool frontFacing = hitDists.x >= 0.0;

    const float dist = frontFacing ? hitDists.x : hitDists.y;

    if (dist < 0.0) {
        discard;
        // Explicit return needed for MSL version < 2.4
        return;
    }

    DiscardBasedOnShading(frontFacing);

    const vec3 intersectionPointObj = rayOriginObj + dist * rayDirObj;

    const mat3 matrixForNormal = transpose(Mat4ToMat3(instanceModelViewInverse));

    vec3 Neye = normalize(matrixForNormal * intersectionPointObj);

    // We get -Neye if this is a backface and the sphere is double-sided
    Neye = GetShadingNormal(Neye, frontFacing);

    const vec3 Peye = TransformPoint(instanceModelView, intersectionPointObj);

    const vec3 ndc = TransformPoint(GetProjectionMatrix(), Peye);

    const float depth = NDCToWindowDepth(ndc.z);

    // We need to manually discard if both intersections are before the near
    // plane because of the depth_greater qualifier
    if (depth < 0.0) {
        discard;
        // Explicit return needed for MSL version < 2.4
        return;
    }
    
    gl_FragDepth = depth;

    vec4 color = vec4(0.5, 0.5, 0.5, 1);
#ifdef HD_HAS_displayColor
    color.rgb = HdGet_displayColor().rgb;
#endif
#ifdef HD_HAS_displayOpacity
    color.a = HdGet_displayOpacity();
#endif

    // hard code patchCoord since the entire implicit surface is one "patch"
    const vec4 patchCoord = vec4(0, 0.5, 0, 0);

    color = ShadingTerminal(vec4(Peye, 1), Neye, color, patchCoord);

#ifdef HD_MATERIAL_TAG_MASKED   
    if (ShouldDiscardByAlpha(color)) {
        discard;
        return;
    }
#endif

    RenderOutput(vec4(Peye, 1), Neye, color, patchCoord);
}
