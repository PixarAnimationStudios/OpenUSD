--- This is what an import might look like.
--- #import $TOOLS/hdSt/shaders/sphere.glslfx

--- --------------------------------------------------------------------------
-- glsl ImplicitSurface.TypeDef.Sphere

struct Sphere
{
    vec3 center;
    float radius;
};

--- --------------------------------------------------------------------------
-- glsl ImplicitSurface.Common.Sphere

#define MAX_HITS (2)

struct Shape
{
    Sphere sphere;
};

Shape ConstructShape()
{
    Shape shape;
    shape.sphere.center = vec3(0.0);
    shape.sphere.radius = HdGet_sphereRadius();

    return shape;
}

MAT4 GetShapeToObjMatrix(const Shape shape)
{
    return MAT4(1.0);
}

MAT4 GetObjToShapeMatrix(const Shape shape)
{
    return MAT4(1.0);
}

--- --------------------------------------------------------------------------
-- glsl ImplicitSurface.Bounds.Sphere

// Computes the min and max bounds for the given sphere in eye space.
Bbox ComputeSphereBboxEye(const Sphere sphere, const MAT4 shapeToEye)
{
    const vec3 shapeCenterEye = TransformPoint(shapeToEye, sphere.center);

    // Get max x, y, and z radii for the sphere's bounding box in eye space
    const vec3 bboxSizeEye = sphere.radius *
                             RowLengths(Mat4ToMat3(shapeToEye));

    Bbox bboxEye;
    bboxEye.minBound = shapeCenterEye - bboxSizeEye;
    bboxEye.maxBound = shapeCenterEye + bboxSizeEye;

    return bboxEye;
}

--- --------------------------------------------------------------------------
-- glsl ImplicitSurface.Vertex.Sphere

// Computes the min and max bounds for the sphere in eye space.
Bbox ComputeBboxEye(const Shape shape, const MAT4 shapeToEye)
{
    return ComputeSphereBboxEye(shape.sphere, shapeToEye);
}

--- --------------------------------------------------------------------------
-- glsl ImplicitSurface.Intersection.Sphere

// Computes the near/far hit distances in shape space for a ray intersecting
// the given sphere.
// rayShape.dir need not be normalized.
vec2 ComputeSphereRoots(const Sphere sphere, const Ray rayShape)
{
    // Coeffs for the quadratic equation for the sphere
    const float a = dot(rayShape.dir, rayShape.dir);
    const float halfB = dot(rayShape.origin - sphere.center, rayShape.dir);
    const float c = dot(rayShape.origin, rayShape.origin)
                    + dot(sphere.center, sphere.center - 2 * rayShape.origin)
                    - sphere.radius * sphere.radius;

    return ComputeRoots(a, halfB, c);
}

// Computes the (unnormalized) normal direction for the point on the
// given sphere in shape space.
// Pshape is assumed to lie on the surface of the sphere.
vec3 ComputeSphereNormal(const Sphere sphere, const vec3 Pshape)
{
    return Pshape - sphere.center;
}

--- --------------------------------------------------------------------------
-- glsl ImplicitSurface.Fragment.Sphere

const uint SPHERE_SEG_SURFACE = 0u;

// Computes the sorted hit points in shape space for a ray intersecting
// the sphere.
// rayShape.dir need not be normalized.
SortedHits ComputeHitsShape(const Shape shape, const Ray rayShape)
{
    const vec2 roots = ComputeSphereRoots(shape.sphere, rayShape);

    SortedHits result;

    for (int i = 0; i < 2; i++) {
        result.hits[i].t = roots[i];
        result.hits[i].segment = SPHERE_SEG_SURFACE;
    }

    return result;
}

// Computes the (unnormalized) shape-space normal at the given point on the
// sphere.
vec3 ComputeNormalShape(const Shape shape, const Point pointShape)
{
    return ComputeSphereNormal(shape.sphere, pointShape.position);
}

--- --------------------------------------------------------------------------
-- glsl ImplicitSurface.Edge.Sphere

// Computes the nearest distance in pixels to the three coordinate-plane
// great circles.
float ComputeSphereEdgeDist(const Sphere sphere,
                            const Point pointShape,
                            const MAT4 shapeToEye,
                            const MAT4 shapeToPixelClip,
                            const mat3 NshapeToNeye,
                            const vec3 PrayDirEye)
{
    const vec3 Nshape = ComputeSphereNormal(sphere, pointShape.position);

    const float Pfacing = ComputeFacing(NshapeToNeye,
                                        Nshape,
                                        PrayDirEye);

    const vec2 Pscreen = TransformPoint(shapeToPixelClip,
                                        pointShape.position).xy;

    Ring ring;
    ring.center = sphere.center;
    ring.radius = abs(sphere.radius);

    float minDist = INF;

    HGI_COMPILER_ATTR_UNROLL
    for (uint i = 0; i < 3; i++) {
        ring.axis = i;

        const vec3 ringPointShape = ComputeNearestRingPointShape(
                                        ring,
                                        pointShape.position,
                                        Pscreen,
                                        shapeToPixelClip);

        const vec3 ringPointNshape = ComputeSphereNormal(
                                         sphere,
                                         ringPointShape);

        const float ringDist = ComputeFacingAwareScreenDist(Pscreen,
                                                            ringPointShape,
                                                            Pfacing,
                                                            ringPointNshape,
                                                            NshapeToNeye,
                                                            shapeToEye,
                                                            shapeToPixelClip);

        minDist = min(minDist, ringDist);
    }

    return minDist;
}

--- --------------------------------------------------------------------------
-- glsl ImplicitSurface.Wire.Sphere

// Computes the nearest distance in pixels to the wireframe edges.
float ComputeWireDist(const Shape shape,
                      const Point pointShape,
                      const MAT4 shapeToEye,
                      const MAT4 shapeToPixelClip,
                      const mat3 NshapeToNeye,
                      const vec3 PrayDirEye)
{
    return ComputeSphereEdgeDist(shape.sphere,
                                 pointShape,
                                 shapeToEye,
                                 shapeToPixelClip,
                                 NshapeToNeye,
                                 PrayDirEye);
}
