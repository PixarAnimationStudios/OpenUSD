--- This is what an import might look like.
--- #import $TOOLS/hdSt/shaders/implicitSurfaceFaceCull.glslfx


--- --------------------------------------------------------------------------
-- glsl ImplicitSurfaceFaceCull.Fragment.None

bool ShouldDiscardBasedOnShading(bool frontFacing)
{
    return false;
}

--- --------------------------------------------------------------------------
-- glsl ImplicitSurfaceFaceCull.Fragment.FrontFacing

bool ShouldDiscardBasedOnShading(bool frontFacing)
{
    return frontFacing;
}

--- --------------------------------------------------------------------------
-- glsl ImplicitSurfaceFaceCull.Fragment.BackFacing

bool ShouldDiscardBasedOnShading(bool frontFacing)
{
    return !frontFacing;
}
