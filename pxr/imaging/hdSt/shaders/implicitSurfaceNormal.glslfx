--- This is what an import might look like.
--- #import $TOOLS/hdSt/shaders/implicitSurfaceNormal.glslfx


--- --------------------------------------------------------------------------
-- glsl ImplicitSurfaceNormal.Fragment.SingleSided

vec3 GetShadingNormal(vec3 N, bool frontFacing)
{
    return N;
}

--- --------------------------------------------------------------------------
-- glsl ImplicitSurfaceNormal.Fragment.DoubleSided

vec3 GetShadingNormal(vec3 N, bool frontFacing)
{
    return frontFacing ? N : -N;
}
