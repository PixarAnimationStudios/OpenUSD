#usda 1.0
(
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root"
{
    def Sphere "MyGeo" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Root/MyMaterial>
    }

    def Material "MyMaterial" (
        prepend references = @standard_surface_default.mtlx@</MaterialX/Materials/Default>
    )
    {}
}

