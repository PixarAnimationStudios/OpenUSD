{
    "Plugins": [
        {
            "Info": {
                "Validators": {
                    "PackageEncapsulationValidator": {
                        "doc": "If the root layer is a package, then its recommended for the composed stage to not contain references to files outside the package. The package should be self-contained, warn if not.", 
                        "keywords": [
                            "UsdzValidators"
                        ]
                    },
                    "PrimTypeValidator": {
                        "doc": "All core types other than UsdGeomPointInstancers, Curve types, Nurbs, and the types in UsdLux are allowed.",
                        "keywords": [
                            "UsdzValidators"
                        ]
                    },
                    "keywords": [
                        "UsdUtilsValidators"
                    ]
                }
            },
            "LibraryPath": "@PLUG_INFO_LIBRARY_PATH@",
            "Name": "usdUtilsValidators", 
            "ResourcePath": "@PLUG_INFO_RESOURCE_PATH@",
            "Root": "@PLUG_INFO_ROOT@",
            "Type": "library"
        }
    ]
}
