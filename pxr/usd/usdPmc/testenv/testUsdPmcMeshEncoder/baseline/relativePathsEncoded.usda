#usda 1.0

def Mesh "Plane" (
    assetInfo = {
        dictionary previews = {
            dictionary thumbnails = {
                dictionary default = {
                    asset defaultImage = @relativePaths/asset.txt@
                }
            }
        }
    }
    prepend references = @pmcCodec/0.pmc@
)
{
    float3[] extent = [(-1, -1, 0), (1, 1, 0)]
    int[] faceVertexCounts
    int[] faceVertexIndices
    normal3f[] normals
    point3f[] points
    int[] primvars:st:indices = [0, 1, 3, 2]
    asset text = @relativePaths/asset.txt@
}

