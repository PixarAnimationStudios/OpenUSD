#usda 1.0

# Prim to be referenced by structure in root.usda. 
# Has children with global and local inherits.
def "Ref"
{
    # Child prim with a global inherit
    def "C" (
        append inherits = </_G>
    )
    {
        # Local class
        class "_Z"
        {
            string prop = "ref:weak"
        }

        # Grandchild prim with local inherit
        def "D" (
            append inherits = <../_Z>
        )
        {
            string prop = "ref:strong"
        }
    }
}

# Global class
class "_G"
{
}

