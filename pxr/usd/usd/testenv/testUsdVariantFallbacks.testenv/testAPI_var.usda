#usda 1.0

def "Sarah" (
    append variantSets = "displayColor"
)
{
    def Scope "EmptyPrim"
    {
    }

    variantSet "displayColor" = {
        "red" {
            custom color3d color = (1, 0, 0)
        }
        "green" {
            custom color3d color = (0, 1, 0)
        }
        "blue" {
            custom color3d color = (0, 0, 1)
        }
    }
}


def "Sarah_ref" (
    append references = @./testAPI_var.usda@</Sarah>
)
{
}
