#usda 1.0
(
    defaultPrim = "Prim"
    endTimeCode = 1
    startTimeCode = 0
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Mesh "Prim"
{
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 3, 2]
    uniform token orientation = "leftHanded"
