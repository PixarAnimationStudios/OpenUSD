#usda 1.0

def Scope "Render"
{
    def RenderSettings "Settings"
    {
    }

    def RenderPass "Pass" (
        prepend apiSchemas = ["CollectionAPI:renderVisibility"]
    )
    {
        rel renderSource = </Render/Settings>
        uniform bool collection:renderVisibility:includeRoot = 1

        custom bool myRenderer:pass:shadowsOnly = 1
        custom int myRenderer:pass:samples = 4
        custom float myRenderer:pass:emissionScale = 0.5
        custom float myRenderer:pass:animated.timeSamples = {
            1: 1,
            2: 2,
        }
    }
}
