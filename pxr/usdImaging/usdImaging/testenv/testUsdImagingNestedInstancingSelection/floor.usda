#usda 1.0
(
    defaultPrim = "Root"
)

def Xform "Root"
{
    def Xform "Row_0" (
        instanceable = true
        prepend references = @row.usda@
    )
    {
        double3 xformOp:translate = (0, 0, -1)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "Row_1" (
        instanceable = true
        prepend references = @row.usda@
    )
    {
        double3 xformOp:translate = (0, 0, 1)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
