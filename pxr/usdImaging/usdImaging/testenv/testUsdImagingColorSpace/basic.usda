#usda 1.0

def Mesh "Plane" (
    apiSchemas = ["MaterialBindingAPI"]
)
{
    uniform bool doubleSided = 1
    float3[] extent = [(-2, -2, -2), (2, 2, 2)]
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    rel material:binding = </Materials/Blue>
    point3f[] points = [(-2, 0, -2), (2, 0, -2), (2, 0, 2), (-2, 0, 2)]
    float2[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (
        interpolation = "vertex"
    )
    float3 xformOp:scale = (.5, .5, .5)
    double3 xformOp:translate = (5, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
}

def Mesh "Plane2" (
    apiSchemas = ["MaterialBindingAPI"]
)
{
    rel material:binding = </Materials/Green>
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 3, 2]
    point3f[] points = [(-1, 0, -1), (1, 0, -1), (-1, 0, 1), (1, 0, 1)]
    texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (
        interpolation = "faceVarying"
    )
    double3 xformOp:translate = (1.5, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
    uniform bool doubleSided = 1
}

def Mesh "Plane3" (
    apiSchemas = ["MaterialBindingAPI"]
)
{
    rel material:binding = </Materials/Red>
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 3, 2]
    point3f[] points = [(-1, 0, -1), (1, 0, -1), (-1, 0, 1), (1, 0, 1)]
    texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (
        interpolation = "faceVarying"
    )
    double3 xformOp:translate = (-2, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
    uniform bool doubleSided = 1
}

def Xform "Materials" (
    apiSchemas = ["ColorSpaceAPI"]
)
{
    uniform token colorSpace:name = "lin_ap0_scene"

    def Material "Red"
    {
        token outputs:surface.connect = </Materials/Red/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.8, 0.1, 0.1)
            float inputs:roughness = 0.35
            token outputs:surface
        }
    }

    def Material "Green" (
        apiSchemas = ["ColorSpaceAPI"]
    )
    {
        uniform token colorSpace:name = "lin_rec2020_scene"
        token outputs:surface.connect = </Materials/Green/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.2, 0.4, 0.2) (
                colorSpace = "sRGB"
            )
            color3f inputs:specularColor = (0.1, 0.25, 0.8)
            float inputs:roughness = 0.01
            token outputs:surface
        }
    }

    def Material "Blue"
    {
        token outputs:surface.connect = </Materials/Blue/Surface.outputs:surface>

        def Shader "Surface"  (
            apiSchemas = ["ColorSpaceAPI"]
        )
        {
            uniform token info:id = "UsdPreviewSurface"
            uniform token colorSpace:name = "srgb_rec709_scene"
            color3f inputs:diffuseColor = (0.1, 0.25, 0.8) (
                colorSpace = "sRGB"
            )
            color3f inputs:specularColor = (0.1, 0.25, 0.8)
            float inputs:roughness = 0.35
            token outputs:surface
        }
    }
}

def Xform "TextureMaterials" (
    apiSchemas = ["ColorSpaceAPI"]
)
{
    uniform token colorSpace:name = "lin_ap0_scene"

    def Material "Mat1"
    {
        token outputs:surface.connect = </TextureMaterials/Mat1/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor.connect = </TextureMaterials/Mat1/Image1.outputs:rgb>
            color3f inputs:SpecularColor.connect = </TextureMaterials/Mat1/Image2.outputs:rgb>
            token outputs:surface
        }
        def Shader "Image1"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = "testImage.png"
            color3f outputs:rgb
        }
        def Shader "Image2"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = "testImage.png" (
                colorSpace = "sRGB"
            )
            color3f outputs:rgb
        }
    }

    def Material "Mat2" (
        apiSchemas = ["ColorSpaceAPI"]
    )
    {
        uniform token colorSpace:name = "lin_rec2020_scene"
        token outputs:surface.connect = </TextureMaterials/Mat2/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor.connect = </TextureMaterials/Mat2/Image1.outputs:rgb>
            color3f inputs:specularColor.connect = </TextureMaterials/Mat2/Image2.outputs:rgb>
            token outputs:surface
        }
        def Shader "Image1"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = "testImage.png"
            color3f outputs:rgb
        }
        def Shader "Image2"(
            apiSchemas = ["ColorSpaceAPI"]
        )
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = "testImage.png"
            uniform token colorSpace:name = "srgb_p3d65_scene"
            color3f outputs:rgb
        }
    }

    def Material "Mat3"(
        apiSchemas = ["ColorSpaceAPI"]
    )
    {
        uniform token colorSpace:name = "lin_rec2020_scene"
        token outputs:surface.connect = </TextureMaterials/Mat3/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor.connect = </TextureMaterials/Mat3/Image.outputs:rgb>
            token outputs:surface
        }
        def Shader "Image"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = "testImage.png"
            token inputs:sourceColorSpace = "raw"
            color3f outputs:rgb
        }
    }
}

def Xform "Lights" (
    apiSchemas = ["ColorSpaceAPI"]
)
{
    uniform token colorSpace:name = "lin_ap0_scene"
    def DistantLight "DistLight1"
    {
        uniform token light:shaderId = "DistantLight" 
        color3f inputs:color = (1,0,0)
    }
    def DistantLight "DistLight2"
    {
        uniform token light:shaderId = "DistantLight" 
        color3f inputs:color = (1,0,0) (
            colorSpace = "lin_rec2020_scene"
        )
    }
    def DomeLight "DomeLight1"
    {
        uniform token light:shaderId = "DomeLight" 
        asset inputs:texture:file = "testImage.png"
        
    }
    def DomeLight "DomeLight2" (
        apiSchemas = ["ColorSpaceAPI"]
    )
    {
        uniform token light:shaderId = "DomeLight" 
        asset inputs:texture:file = "testImage.png"
        uniform token colorSpace:name = "srgb_rec709_scene"
    }
}

