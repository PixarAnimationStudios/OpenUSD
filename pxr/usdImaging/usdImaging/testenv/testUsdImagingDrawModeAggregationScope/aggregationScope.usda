#usda 1.0
(
    upAxis = "Z"
)

# Two instances sharing one prototype, each carrying the draw mode opinion on
# the instanceable prim itself.  This puts geomModel into the instance 
# aggregation binding hash, and since both instances share a hash they share a
# single binding scope.

class Xform "_prototype"
{
    def Mesh "Geom"
    {
        float3[] extent = [(-1, -1, 0), (1, 1, 0)]
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-1, -1, 0), (1, -1, 0), (1, 1, 0), (-1, 1, 0)]
    }
}

def Xform "World"
{
    def Xform "Instance1" (
        prepend apiSchemas = ["GeomModelAPI"]
        kind = "component"
        instanceable = true
        prepend references = </_prototype>
    )
    {
        uniform bool model:applyDrawMode = 1
        uniform token model:drawMode = "cards"
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "Instance2" (
        prepend apiSchemas = ["GeomModelAPI"]
        kind = "component"
        instanceable = true
        prepend references = </_prototype>
    )
    {
        uniform bool model:applyDrawMode = 1
        uniform token model:drawMode = "cards"
        double3 xformOp:translate = (5, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
