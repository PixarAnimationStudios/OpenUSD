#usda 1.0
(
    defaultPrim = "Scene"
    endTimeCode = 1
    startTimeCode = 1
    upAxis = "Z"
)

def Xform "Scene" (
    kind = "component"
    )
{
    def Scope "Looks"
    {
        def Material "Material_0"
        {
            token outputs:surface.connect = </Scene/Looks/Material_0/PbrPreview.outputs:surface>

            def "PbrPreview" (
                inherits = [</_class_Preview>]
            )
            {
                float inputs:metallic = 0.0
            }
        }

        def Material "Material_25"
        {
            token outputs:surface.connect = </Scene/Looks/Material_25/PbrPreview.outputs:surface>

            def "PbrPreview" (
                inherits = [</_class_Preview>]
            )
            {
                float inputs:metallic = 0.25
            }
        }

        def Material "Material_50"
        {
            token outputs:surface.connect = </Scene/Looks/Material_50/PbrPreview.outputs:surface>

            def "PbrPreview" (
                inherits = [</_class_Preview>]
            )
            {
                float inputs:metallic = 0.5
            }
        }

        def Material "Material_75"
        {
            token outputs:surface.connect = </Scene/Looks/Material_75/PbrPreview.outputs:surface>

            def "PbrPreview" (
                inherits = [</_class_Preview>]
            )
            {
                float inputs:metallic = 0.75
            }
        }

        def Material "Material_1"
        {
            token outputs:surface.connect = </Scene/Looks/Material_1/PbrPreview.outputs:surface>

            def "PbrPreview" (
                inherits = [</_class_Preview>]
            )
            {
                float inputs:metallic = 1.0
            }
        }

    }

    def Xform "Geom"
    {
        def Xform "Geom0"
        {
            def "pSphere0" (
                references = </Prototypes/Sphere>
            )
            {
                rel material:binding = </Scene/Looks/Material_0>
                double3 xformOp:translate = (0, 0, 0)
            }

        }

        def Xform "Geom1"
        {
            def "pSphere1" (
                references = </Prototypes/Sphere>
            )
            {
                rel material:binding = </Scene/Looks/Material_25>
                double3 xformOp:translate = (3, 0, 0)
            }

        }

        def Xform "Geom2"
        {
            def "pSphere2" (
                references = </Prototypes/Sphere>
            )
            {
                rel material:binding = </Scene/Looks/Material_50>
                double3 xformOp:translate = (6, 0, 0)
            }

        }

        def Xform "Geom3"
        {
            def "pSphere3" (
                references = </Prototypes/Sphere>
            )
            {
                rel material:binding = </Scene/Looks/Material_75>
                double3 xformOp:translate = (9, 0, 0)
            }

        }

        def Xform "Geom4"
        {
            def "pSphere4" (
                references = </Prototypes/Sphere>
            )
            {
                rel material:binding = </Scene/Looks/Material_1>
                double3 xformOp:translate = (12, 0, 0)
            }

        }
    }
}

def Scope "Prototypes"(active=false)
{
    def Sphere "Sphere" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-1, -1, -1), (1, 1, 1)]
        color3f[] primvars:displayColor = [(0.0, 1.0, 0.0)]
        uniform token[] xformOpOrder = [ "xformOp:translate" ]
    }
}

class Shader "_class_Preview"
{
    uniform token info:id = "UsdPreviewSurface"

    color3f inputs:diffuseColor = (1.0, 0.0, 0.0)
    float inputs:opacity = 0.2

    token outputs:surface
}
