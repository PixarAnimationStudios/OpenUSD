    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def Camera "main_cam"
{
    double3 xformOp:translate = (0, 0, 85)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def Camera "pick_cam"
{
    float2 clippingRange = (1, 20)
    float focalLength = 90
    uniform token guideVisibility = "visible"
    double3 xformOp:translate.timeSamples = {
        1 : (-10, 8, 18),
        2 : (-2, 8, 18),
        3 : (2, 8, 18),
        4 : (9,10, 18),
        5 : (14,10,18),
        6 : (14,6,18),
        7 : (-12,0,18),
        8 : (-7,0,18),
        9 : (4,0,18),
        10 : (10, 0, 18),
        11 : (-15,-5,18),
        12 : (-5,-5,18),
        13 : (11,-10,18)
    }
    uniform token[] xformOpOrder = ["xformOp:translate"]
}