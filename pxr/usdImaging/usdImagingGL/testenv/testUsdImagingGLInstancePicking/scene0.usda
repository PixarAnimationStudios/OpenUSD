#usda 1.0
(
    startTimeCode = 1
    endTimeCode = 13
)

def Xform "RedPrototype" (
    active = false
)
{
    def Cube "RedCube"
    {
        color3f[] primvars:displayColor = [(1, 0, 0)]
    }
}

def Xform "GreenPrototype" (
    active = false
)
{
    def Cube "GreenCube"
    {
        color3f[] primvars:displayColor = [(0, 1, 0)]
    }
}

def Xform "NiPrototype" (
    active = false
)
{
    def "Instance0" (
        active = true
        instanceable = true
        references = </RedPrototype>
    )
    {
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def "Instance1" (
        active = true
        instanceable = true
        references = </RedPrototype>
    )
    {
        double3 xformOp:translate = (3, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}

def Xform "NoInstancing"
{
    def Xform "Scope"
    {
        def Cube "GreenCube"
        {
            color3f[] primvars:displayColor = [(0, 1, 0)]
        }
    }

    double3 xformOp:translate = (-10, 8, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

