def PointInstancer "PiInstancing"
{
    rel prototypes = [</NoInstancing/Scope>,
                      </PiInstancing/Prototype>]
    int[] protoIndices = [ 0, 1, 0 ]
    point3f[] positions = [ (-3, 0, 0), (0, 0, 0), (3, 0, 0) ]

    def Xform "Prototype"
    {
        def Cube "BlueCube"
        {
            color3f[] primvars:displayColor = [(0, 0, 1)]
        }
    }

    double3 xformOp:translate = (-8, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def PointInstancer "PiNiInstancing"
{
    rel prototypes = [</PiNiInstancing/Prototype0>,
                      </PiNiInstancing/Prototype1>]
       
    int[] protoIndices = [ 0, 1, 0 ]
    point3f[] positions = [ (-3, 0, 0), (0, 0, 0), (3, 0, 0) ]

    def Xform "Prototype0" (
        active = true
        instanceable = true
        references = </RedPrototype>
    )
    {
    }

    def Xform "Prototype1"
    {
        def Xform "Instance" (
            active = true
            instanceable = true
            references = </GreenPrototype>
        )
        {
        }
    }

    double3 xformOp:translate = (8, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def Xform "PiNiNiPrototype" (
    active = false
)
{
    def PointInstancer "PiNiNiInstancing"
    {
        rel prototypes = [</PiNiNiPrototype/PiNiNiInstancing/Prototype>]
       
        int[] protoIndices = [ 0, 0, 0 ]
        point3f[] positions = [ (0, 3, 0), (0, 0, 0), (0, -3, 0) ]

        def Xform "Prototype"
        {
            def Xform "NiInstance0" (
                active = true
                instanceable = true
                references = </NiPrototype>
            )
            {
                double3 xformOp:translate = (-4, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }
            def Xform "NiInstance1" (
                active = true
                instanceable = true
                references = </NiPrototype>
            )
            {
                double3 xformOp:translate = (4, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }
        }
    }

    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

