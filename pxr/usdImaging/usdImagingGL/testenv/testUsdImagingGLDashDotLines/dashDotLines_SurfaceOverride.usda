#usda 1.0
(
    upAxis = "Y"
)

def "MyPattern" (
    prepend apiSchemas = ["DashDotPatternAPI"]
)
{
    float patternPeriod = 15
    float2[] pattern = [(0, 10)]
}

def DashDotLines "curve" (
    inherits = [</MyPattern>]
    prepend apiSchemas = ["MaterialBindingAPI"]
){
    float3[] extent = [(-10, 0, 0),(10, 100, 0)]
    uniform bool screenSpacePattern = true
    uniform token startCapType = "round"
    uniform token endCapType = "round"
    uniform float patternScale = 5

    int[] curveVertexCounts = [3, 4, 4]
    point3f[] points = [(0, 0, 0), (10, 10, 0), (10, 20, 0), (0, 30, 0), (-10, 40, 0), (-10, 50, 0), (0, 60, 0), (10, 70, 0), (10, 80, 0), (0, 90, 0), (-10, 100, 0)]
    float[] widths = [5] (interpolation = "constant")
    color3f[] primvars:displayColor = [(0, 0, 1)]
    rel material:binding = </CurveMaterial>
}

def Material "CurveMaterial"
{
    token outputs:surface.connect = </CurveMaterial/CurveShader.outputs:surface>

    def Shader "CurveShader"
    {
        uniform asset info:glslfx:sourceAsset = @CurveSurface.glslfx@
        uniform token info:implementationSource = "sourceAsset"
        token outputs:surface
    }
}