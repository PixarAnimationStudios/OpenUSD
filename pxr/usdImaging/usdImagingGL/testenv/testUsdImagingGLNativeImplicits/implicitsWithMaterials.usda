def Scope "Materials" {
    def "MaterialX" (
        references = [
            # USD Preview Surface MaterialX Nodes
            @./mtlxFiles/usd_preview_surface_nodes.mtlx@</MaterialX>,
        ]
    )
    {
    }
}

def Xform "lights"
{
    def DomeLight "DomeLight"
    {
        asset inputs:texture:file = "./StinsonBeach.hdr"
    }
}
