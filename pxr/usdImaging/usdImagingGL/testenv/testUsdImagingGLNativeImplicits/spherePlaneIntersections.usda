#usda 1.0
(
    defaultPrim = "world"
    upAxis = "Z"
)

def Camera "main_cam"
{
    float4[] clippingPlanes = []
    float2 clippingRange = (53.038, 60.4)
    float focalLength = 68.5216
    float focusDistance = 61.13806
    float fStop = 0
    float horizontalAperture = 17.515018
    float horizontalApertureOffset = 0
    token projection = "perspective"
    float verticalAperture = 20.955
    float verticalApertureOffset = 0
    matrix4d xformOp:transform = ( (-0.0784590957278346, -0.9969173337331287, 2.2136011551168816e-16, 0), (0.21152359920390632, -0.016647268291031504, 0.9772311064626789, 0), (-0.9742186290958491, 0.07667266893017309, 0.21217767215644623, 0), (-45.37666363305091, 8.589507999017151, 17.55299805543655, 1) )
    uniform token[] xformOpOrder = ["xformOp:transform"]
}

def Xform "world"
{
    def Xform "sphere1Xform"
    {
        double3 xformOp:translate = (20, 2, 3)
        double3 xformOp:rotateXYZ = (45, 70, 60)
        double3 xformOp:scale = (2, 6, 3)
        uniform token[] xformOpOrder = [
            "xformOp:translate",
            "xformOp:rotateXYZ",
            "xformOp:scale"
        ]

        def Sphere "sphere1"
        {
            color3f[] primvars:displayColor = [(0, 0.3, 0.6)]

            double radius = 2.5
        }
    }

    def Xform "sphere2Xform"
    {
        double3 xformOp:translate = (-2, 2, 5)
        double3 xformOp:scale = (0.5, 0.5, 0.5)
        uniform token[] xformOpOrder = [
            "xformOp:translate",
            "xformOp:scale"
        ]

        def Sphere "sphere2"
        {
            color3f[] primvars:displayColor = [(0.8, 0.2, 0.2)]

            double radius = 4.0
        }
    }

    def Xform "sphere3Xform"
    {
        double3 xformOp:translate = (10, 2, 3)
        double3 xformOp:scale = (5, 2, 10)
        uniform token[] xformOpOrder = [
            "xformOp:translate",
            "xformOp:scale"
        ]

        def Sphere "sphere3"
        {
            color3f[] primvars:displayColor = [(0, 0.9, 0.6)]

            double radius = 1.0
        }
    }
}

def Xform "lights" 
{
    def DomeLight "DomeLight"
    {
        asset inputs:texture:file = "./StinsonBeach.hdr"
    }
}
