    matrix4d xformOp:transform = ( (0.9999904807207345, 0.004363309284746571, -9.688492862972733e-19, 0), (0, 2.220446049250313e-16, 1, 0), (0.004363309284746571, -0.9999904807207345, 2.2204249122042763e-16, 0), (14.468019210471157, -89.02460856019046, 3.000000000000021, 1) )
    uniform token[] xformOpOrder = ["xformOp:transform"]
}

def Xform "world"
{
    def Xform "capsule1Xform"
    {
        double3 xformOp:translate = (20, 2, 3)
