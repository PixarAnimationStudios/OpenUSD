#usda 1.0
(
    defaultPrim = "world"
    upAxis = "Z"
)

def Camera "main_cam"
{
    float4[] clippingPlanes.timeSamples = {
        1: [(0, 0, -1, -26)],
        2: [(0.08, 0.08, -1, -26)],
        3: [(0.15, 0, -1, -26), (0, 0.15, -1, -26)],
        4: [(1, 0, 0, 0)],
        5: [(1, 0.5, 0, 0)],
    }
    float2 clippingRange = (1, 2000000)
    float focalLength = 34.2608
    float focusDistance = 30
    float fStop = 0
    float horizontalAperture = 20.377293
    float horizontalApertureOffset = 0
    token projection = "perspective"
    float verticalAperture = 20.955
    float verticalApertureOffset = 0
    double3 xformOp:translate = (0, 0, 30)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def Xform "world"
{
    def Sphere "sphere1"
    {
        color3f[] primvars:displayColor = [(0, 0.3, 0.6)]
        double radius = 5.0
    }
}
