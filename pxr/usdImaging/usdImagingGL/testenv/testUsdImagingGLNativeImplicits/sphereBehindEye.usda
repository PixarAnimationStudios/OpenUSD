#usda 1.0
(
    defaultPrim = "world"
    upAxis = "Z"
)

def Camera "main_cam"
{
    float4[] clippingPlanes = []
    float2 clippingRange = (1, 2000000)
    float focalLength = 68.5216
    float focusDistance = 13.150047
    float fStop = 0
    float horizontalAperture = 30.887257
    float horizontalApertureOffset = 0
    token projection = "perspective"
    float verticalAperture = 20.955
    float verticalApertureOffset = 0
    matrix4d xformOp:transform = ( (0.9999904807207345, 0.004363309284757127, -9.688492862996172e-19, 0), (0, 2.220446049250313e-16, 1, 0), (0.004363309284757127, -0.9999904807207345, 2.2204249122042763e-16, 0), (14.12822463505606, -11.14992248106352, 2.999999999999994, 1) )
    uniform token[] xformOpOrder = ["xformOp:transform"]
}

def Xform "world"
{
    def Xform "sphere1Xform"
    {
        double3 xformOp:translate = (20, 2, 3)
        double3 xformOp:rotateXYZ = (45, 70, 60)
        double3 xformOp:scale = (2, 6, 3)
        uniform token[] xformOpOrder = [
            "xformOp:translate",
            "xformOp:rotateXYZ",
            "xformOp:scale"
        ]

        def Sphere "sphere1"
        {
            color3f[] primvars:displayColor = [(0, 0.3, 0.6)]

            double radius = 2.5
        }
    }

    def Xform "sphere2Xform"
    {
        double3 xformOp:translate = (-2, 2, 5)
        double3 xformOp:scale = (0.5, 0.5, 0.5)
        uniform token[] xformOpOrder = [
            "xformOp:translate",
            "xformOp:scale"
        ]

        def Sphere "sphere2"
        {
            color3f[] primvars:displayColor = [(0.8, 0.2, 0.2)]

            double radius = 4.0
        }
    }

    def Xform "sphere3Xform"
    {
        double3 xformOp:translate = (10, 2, 3)
        double3 xformOp:scale = (5, 2, 10)
        uniform token[] xformOpOrder = [
            "xformOp:translate",
            "xformOp:scale"
        ]

        def Sphere "sphere3"
        {
            color3f[] primvars:displayColor = [(0, 0.9, 0.6)]

            double radius = 1.0
        }
    }
}
