#usda 1.0
(
    defaultPrim = "world"
    upAxis = "Z"
)

def Camera "main_cam"
{
    float4[] clippingPlanes = []
    float2 clippingRange = (1, 2000000)
    float focalLength = 34.2608
    float focusDistance = 4.5
    float fStop = 0
    float horizontalAperture = 22.711006
    float horizontalApertureOffset = 0
    token projection = "perspective"
    float verticalAperture = 20.955
    float verticalApertureOffset = 0
    matrix4d xformOp:transform = ( (1, 0, 0, 0), (0, 2.220446049250313e-16, 1, 0), (0, -1, 2.220446049250313e-16, 0), (0, -4, 0, 1) )
    uniform token[] xformOpOrder = ["xformOp:transform"]
}

def Xform "world"
{
    def Cylinder_1 "outerCylinder"
    {
        uniform token axis = "Z"
        color3f[] primvars:displayColor = [(0, 0.9, 0.6)]
        double height = 10.0
        double radiusBottom = 5.0
        double radiusTop = 4.0
    }

    def Xform "innerCylinderXform"
    {
        double3 xformOp:translate = (0.35, 1, 0)
        double3 xformOp:rotateXYZ = (50, 15, 20)
        uniform token[] xformOpOrder = [
            "xformOp:translate",
            "xformOp:rotateXYZ"
        ]

        def Cylinder_1 "innerCylinder"
        {
            uniform token axis = "Z"
            color3f[] primvars:displayColor = [(0.8, 0.2, 0.2)]
            double height = 2.5
            double radiusBottom = 0.9
            double radiusTop = 0.45
        }
    }
}

def Xform "lights"
{
    def DomeLight "DomeLight"
    {
        asset inputs:texture:file = "./StinsonBeach.hdr"
    }
}
