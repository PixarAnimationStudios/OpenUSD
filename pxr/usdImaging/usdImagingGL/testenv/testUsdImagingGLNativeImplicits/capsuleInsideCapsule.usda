#usda 1.0
(
    defaultPrim = "world"
    upAxis = "Z"
)

def Camera "main_cam"
{
    float4[] clippingPlanes = []
    float2 clippingRange = (1, 2000000)
    float focalLength = 34.2608
    float focusDistance = 2.0102525
    float fStop = 0
    float horizontalAperture = 49.513924
    float horizontalApertureOffset = 0
    token projection = "perspective"
    float verticalAperture = 20.955
    float verticalApertureOffset = 0
    matrix4d xformOp:transform = ( (0.9981347984218669, -0.06104853953485689, 1.3555498842267452e-17, 0), (-0.009550095623622721, -0.1561426832291632, 0.9876883405951378, 0), (-0.06029693070893946, -0.9858461027435561, -0.15643446504023065, 0), (-0.1212120513908414, -1.9817993575661494, -0.31447276325366924, 1) )
    uniform token[] xformOpOrder = ["xformOp:transform"]
}

def Xform "world"
{
    def Xform "inner"
    {
        def Capsule "capsule"
        {
            uniform token axis = "X"
            double height = 1.0
            double radius = 0.4
            color3f[] primvars:displayColor = [(0.8, 0.2, 0.2)]
        }
    }

    def Xform "outer"
    {
        def Capsule_1 "capsule"
        {
            uniform token axis = "Z"
            double height = 4.0
            double radiusTop = 2.0
            double radiusBottom = 2.0
            color3f[] primvars:displayColor = [(0.1, 0.7, 0.4)]
        }
    }
}

def Xform "lights"
{
    def DomeLight "DomeLight"
    {
        asset inputs:texture:file = "./StinsonBeach.hdr"
    }
}
