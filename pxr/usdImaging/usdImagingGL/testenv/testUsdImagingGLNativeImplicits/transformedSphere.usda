#usda 1.0
(
    defaultPrim = "world"
)

def Camera "main_cam"
{
    float4[] clippingPlanes = []
    float2 clippingRange = (1, 2000000)
    float focalLength = 34.2608
    float focusDistance = 37.93703
    float fStop = 0
    float horizontalAperture = 22.711006
    float horizontalApertureOffset = 0
    token projection = "perspective"
    float verticalAperture = 20.955
    float verticalApertureOffset = 0
    matrix4d xformOp:transform = ( (1, 0, 0, 0), (0, 2.220446049250313e-16, 1, 0), (0, -1, 2.220446049250313e-16, 0), (100.00000000000003, -35.93703159949516, 3.0000000000000124, 1) )
    uniform token[] xformOpOrder = ["xformOp:transform"]
}

def Xform "world"
{
    double3 xformOp:translate = (100, 2, 3)
    double3 xformOp:rotateXYZ = (45, 70, 60)
    double3 xformOp:scale = (2, 6, 3)
    uniform token[] xformOpOrder = [
        "xformOp:translate",
        "xformOp:rotateXYZ",
        "xformOp:scale"
    ]

    def Sphere "sphere1"
    {
        color3f[] primvars:displayColor = [(0, 0.3, 0.6)]

        double radius = 2.5
    }
}
